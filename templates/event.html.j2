{% extends "base.html.j2" %}
{% from "_talk.html.j2" import talk_line %}
{% block title %}{{ event.title }} – PyData Helsinki{% endblock %}
{% block canonical %}{{ event.url }}{% endblock %}
{% block og_title %}{{ event.title }}, {{ event.display_date }} – PyData Helsinki{% endblock %}
{% block og_type %}article{% endblock %}
{% if event.banner %}
{% block og_image %}{{ event.og_image }}{% endblock %}
{% block og_image_width %}1200{% endblock %}
{% block og_image_height %}630{% endblock %}
{% block og_image_type %}image/avif{% endblock %}
{% endif %}
{% block description %}{{ event.display_date }}{% if event.venue.name %} at {{ event.venue.name }}{% endif %}. {% if event.summary %}{{ event.summary }}{% else %}PyData Helsinki: {{ event.title }}.{% endif %}{% endblock %}
{% block head_extra %}
  <script type="application/ld+json">
{{ jsonld | safe }}
  </script>
{% endblock %}
{% block body %}
    <nav><a href="/">← PyData Helsinki</a></nav>
    <hgroup>
    <h1>{{ event.title }}</h1>
    <p>
      <time datetime="{{ event.machine_date }}">{{ event.display_date }}</time>
      {%- if event.venue.name %} ·
        {%- if event.venue.url %} <a href="{{ event.venue.url }}">{{ event.venue.name }}</a>
        {%- else %} {{ event.venue.name }}
        {%- endif %}
        {%- if event.venue.address %}, {{ event.venue.address }}{% endif %}
      {%- endif %}
      {%- if event.status == "cancelled" %} · <strong>Cancelled</strong>{% endif %}
    </p>
    </hgroup>

    {% if event.summary %}
    <p>{{ event.summary }}</p>
    {% endif %}

    {% if event.effective_sponsor %}
    <p>Sponsored by
      {%- if event.effective_sponsor.url %} <a href="{{ event.effective_sponsor.url }}">{{ event.effective_sponsor.name }}</a>
      {%- else %} {{ event.effective_sponsor.name }}
      {%- endif %}.</p>
    {% endif %}

    {% if is_upcoming and event.rsvp_open and event.status != "cancelled" %}
    <p><strong><a href="{{ event.registration.url }}" rel="nofollow">Register on {{ event.registration.platform | default("Meetup") }} →</a></strong>
    Attendance is free of charge.</p>
    {% elif is_upcoming and event.status != "cancelled" %}
    <p>Registration is not open yet{% if event.registration.opens %}; it is scheduled to open on
    <time datetime="{{ event.registration.opens.isoformat() }}">{{ event.display_opens }}</time>{% endif %}.
    The best way to hear immediately when it does is
    <a href="https://helsinki-python.github.io/discord">the Helsinki Python Discord</a>,
    or you can use any feed reader to subscribe to updates.
    Attendance is free of charge.</p>
    {% endif %}

    {% if is_upcoming and event.status != "cancelled" and event.start %}
    <script src="/assets/atcb.min.js" async defer></script>
    <add-to-calendar-button
      name="PyData Helsinki: {{ event.title }}"
      startDate="{{ event.start.strftime('%Y-%m-%d') }}"
      {% if event.start.hour or event.start.minute %}
      startTime="{{ event.start.strftime('%H:%M') }}"
      endTime="{{ (event.end or event.start).strftime('%H:%M') }}"
      {% endif %}
      endDate="{{ (event.end or event.start).strftime('%Y-%m-%d') }}"
      timeZone="Europe/Helsinki"
      {% if event.venue.name %}
      location="{{ event.venue.name }}{% if event.venue.address %}, {{ event.venue.address }}{% endif %}"
      {% endif %}
      description="{% if event.summary %}{{ event.summary }} {% endif %}[url]{{ event.url }}[/url]"
      iCalFileName="{{ event.slug }}"
      options="'Apple','Google','iCal','Microsoft365','Outlook.com'"
      lightMode="system"
      hideBranding="true"
      hideRichData="true"
      size="4"
      styleLight="--font: inherit; --btn-background: #f9f9f9; --btn-text: #398BAB; --accent-color: #398BAB; --list-background: #f9f9f9; --list-text: #333;"
      styleDark="--btn-background: #1e1e1e; --btn-text: #5aadcc; --accent-color: #5aadcc; --list-background: #1e1e1e; --list-text: #e0e0e0;"
    ></add-to-calendar-button>
    {% endif %}

    {% if event.schedule %}
    <h2>Schedule</h2>
    <ul>
      {% for row in event.schedule %}
      <li><time>{{ row.time }}</time> — {{ row.item }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if event.talks %}
    <h2>Programme</h2>
    <ul>
      {% for talk in event.talks %}
      <li>{{ talk_line(talk) }}
        {%- if talk.description %}
        {{ talk.description | markdown }}
        {%- endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if is_upcoming and event.seeking_talks and event.status != "cancelled" %}
    <p>We are looking for more talks! Propose one on
    <a href="https://helsinki-python.github.io/discord">the Helsinki Python Discord</a>
    or by email to
    <a href="mailto:pydata-helsinki-organisers@googlegroups.com">pydata-helsinki-organisers@googlegroups.com</a>.
    See <a href="/for-speakers/">information for speakers</a> for ideas and practicalities.</p>
    {% endif %}

    {% if event.venue.lat and event.venue.lon %}
    <h2>Location</h2>
    <div id="map" class="map"></div>
    <p><a href="https://www.openstreetmap.org/?mlat={{ event.venue.lat }}&mlon={{ event.venue.lon }}#map=17/{{ event.venue.lat }}/{{ event.venue.lon }}">Map location</a></p>
    <link rel="stylesheet" href="/assets/maplibre-gl.css">
    <script defer src="/assets/maplibre-gl.js"></script>
    <script>
      addEventListener('DOMContentLoaded', () => {
        const center = [{{ event.venue.lon }}, {{ event.venue.lat }}];
        const map = new maplibregl.Map({
          container: 'map',
          style: 'https://tiles.openfreemap.org/styles/liberty',
          center,
          zoom: 14.5,
          cooperativeGestures: true,
        });
        new maplibregl.Marker().setLngLat(center).addTo(map);
      });
    </script>
    {% endif %}

    {% if event.joint_with %}
    <p>Organised together with
      {%- for partner in event.joint_with %} {{ partner }}{% if not loop.last %},{% endif %}{% endfor %}.</p>
    {% endif %}

    {% if not is_upcoming and event.registration.url %}
    <p>This event has taken place. The original event listing is
    <a href="{{ event.registration.url }}" rel="nofollow">on {{ event.registration.platform | default("Meetup") }}</a>.</p>
    {% endif %}

    <footer>
    <p><a href="/">PyData Helsinki</a> · <a href="/#upcoming">Upcoming events</a> ·
       <a href="/events.ics">Subscribe to our calendar</a></p>
    </footer>
{% endblock %}
