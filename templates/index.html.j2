{% extends "base.html.j2" %}
{% block head_extra %}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ site_url }}/#organization",
      "name": "PyData Helsinki",
      "url": "{{ site_url }}/",
      "logo": "{{ site_url }}/assets/favicon.svg",
      "image": "{{ default_image }}",
      "email": "pydata-helsinki-organisers@googlegroups.com",
      "description": "A meetup group of Python and data enthusiasts in Helsinki, Finland. Talks on machine learning, data engineering, MLOps, visualization, and statistical modeling with open-source tools.",
      "areaServed": {
        "@type": "City",
        "name": "Helsinki",
        "address": {"@type": "PostalAddress", "addressCountry": "FI"}
      },
{% if community.member_count %}
      "interactionStatistic": {
        "@type": "InteractionCounter",
        "interactionType": "https://schema.org/JoinAction",
        "userInteractionCount": {{ community.member_count }}
      },
{% endif %}
      "sameAs": [
        "https://www.meetup.com/pydata-helsinki/",
        "https://www.linkedin.com/company/pydata-helsinki/",
        "https://fosstodon.org/@pydata_helsinki",
        "https://www.youtube.com/@PyData_Helsinki"
      ],
      "sponsor": {
        "@type": "Organization",
        "name": "NumFOCUS",
        "url": "https://numfocus.org/"
      }
    },
    {
      "@type": "WebSite",
      "url": "{{ site_url }}/",
      "name": "PyData Helsinki",
      "publisher": {"@id": "{{ site_url }}/#organization"},
      "inLanguage": "en"
    }{% if upcoming_jsonld %},
{{ upcoming_jsonld | safe }}
{% endif %}
  ]
}
  </script>
{% endblock %}
